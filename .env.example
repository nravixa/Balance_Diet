# ==============================================================================
# BALANCE DIET PUNE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: NEVER commit real credentials, API keys, or production secrets to Git!
# ==============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Balance Diet Pune"
NEXT_PUBLIC_APP_DESCRIPTION="Personalized Nutrition, Diet Plans, and Healthy Living in Pune"

# Contact & Business Information
NEXT_PUBLIC_CONTACT_EMAIL="contact@balancedietpune.com"
NEXT_PUBLIC_CONTACT_PHONE="+91-9876543210"
NEXT_PUBLIC_WHATSAPP_NUMBER="+919876543210"
NEXT_PUBLIC_CLINIC_CITY="Pune, Maharashtra, India"

# Security & Authentication (Generate secure 32+ character strings for production)
# Example command: openssl rand -base64 32
AUTH_SECRET="your-development-auth-secret-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Database / Storage (Optional: Uncomment if using Postgres / Supabase / Prisma)
# DATABASE_URL="postgresql://user:password@localhost:5432/balancediet?schema=public"

# External APIs & Integrations (Replace with actual development tokens)
# NEXT_PUBLIC_ANALYTICS_ID=""
# RESEND_API_KEY="re_123456789"

